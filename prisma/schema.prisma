// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  hashedPassword String?
  name          String?
  phone         String?
  role          Role      @default(CUSTOMER)
  image         String?
  emailVerified DateTime?

  // 📦 Consolidated shipping address (JSON) — new format
  shippingAddressJson Json?  @map("shipping_address_json")

  // 🏚️ Legacy individual shipping fields – used throughout the app
  shippingAddress String?
  shippingCity    String?
  shippingProvince String?
  shippingZip     String?
  shippingCountry String?  @default("Nepal")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  backInStockRequests BackInStockRequest[]
  giftCards      GiftCard[]
  accounts       Account[]
  sessions       Session[]

  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  shortDescription String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  basePrice     Decimal   @default(0)
  salePrice     Decimal?
  isOnSale      Boolean   @default(false)
  isNew         Boolean   @default(false)
  isActive      Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  status        ProductStatus @default(ACTIVE)
  material      String?
  careInstructions String?
  weight        Decimal?
  brand         String?
  tags          Json      @default("[]")
  inStock       Boolean   @default(true)
  stockQuantity Int       @default(0)
  lowStockThreshold Int   @default(5)
  sortOrder     Int       @default(0)
  isTrending    Boolean   @default(false)
  isBestSeller  Boolean   @default(false)
  metaTitle     String?
  metaDescription String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants       ProductVariant[]
  images         ProductImage[]
  collections    CollectionItem[]
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  backInStockRequests BackInStockRequest[]

  @@index([categoryId])
  @@index([slug])
  @@index([brand])
  @@index([isActive, isFeatured])
  @@index([isActive, isTrending, isBestSeller])
  @@index([isOnSale, isActive])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String?
  colorHex  String?
  sku       String?  @unique
  price     Decimal?
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
  backInStockRequests BackInStockRequest[]

  @@unique([productId, size, color])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model Collection {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("collections")
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, productId])
  @@map("collection_items")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  status          OrderStatus  @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal      @default(0)
  shippingCost    Decimal      @default(0)
  tax             Decimal      @default(0)
  discount        Decimal      @default(0)
  total           Decimal      @default(0)

  // 📦 Shipping address (JSON – supersedes individual fields)
  shippingInfo    Json?

  // [Deprecated] Individual shipping fields – kept for backwards compat
  shippingName_old    String?  @map("shippingName")
  shippingPhone_old   String?  @map("shippingPhone")
  shippingAddress_old String?  @map("shippingAddress")
  shippingCity_old    String?  @map("shippingCity")
  shippingProvince_old String? @map("shippingProvince")
  shippingZip_old     String?  @map("shippingZip")
  shippingCountry_old String?  @default("Nepal") @map("shippingCountry")

  paymentMethod   String?
  paymentDetails  String?
  paymentReference String?
  paymentProvider String?
  notes           String?
  couponCode      String?
  isGift          Boolean      @default(false)
  giftMessage     String?

  deletedAt DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String
  size      String?
  color     String?
  sku       String?
  price     Decimal
  quantity  Int
  imageUrl  String?

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  title     String?
  comment   String?
  isApproved Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([rating])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("reviews")
}

model JournalArticle {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String?
  content       String?
  coverImage    String?
  author        String   @default("PEA_FITS")
  category      String?
  tags          Json      @default("[]")
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  metaTitle     String?
  metaDescription String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([deletedAt])
  @@map("journal_articles")
}

model BrandBookSection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?
  image       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("brand_book_sections")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model SiteSettings {
  id        String   @id @default("default")
  siteName  String   @default("PEA FITS")
  tagline   String?
  logoUrl   String?
  faviconUrl String?
  email     String?
  phone     String?
  address   String?
  socialLinks String?
  shippingConfig String?
  seoDefaults  String?
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
  @@index([email])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ═════════════════════════════════════════════
// Super Admin CMS Models (Phase B)
// ═════════════════════════════════════════════

model HomepageConfig {
  id              String  @id @default("default")
  heroTitle       String?
  heroSubtitle    String?
  heroCtaText     String?
  heroCtaLink     String?
  heroImage       String?
  announcement    String?  @default("")
  announcementEnabled Boolean @default(false)
  featuredSectionTitle String? @default("Featured Collection")
  featuredCollectionId String?
  updatedAt       DateTime @updatedAt

  @@map("homepage_config")
}

model NavLink {
  id        String  @id @default(cuid())
  label     String
  href      String
  sortOrder Int     @default(0)
  section   String  // "main" | "footer_shop" | "footer_info" | "footer_support"
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, sortOrder])
  @@map("nav_links")
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String  // "instagram" | "facebook" | "tiktok" | "twitter" | "youtube"
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  @@index([platform])
  @@map("social_links")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  location  String?
  rating    Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
  @@map("testimonials")
}

model Coupon {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String   // "percentage" | "fixed"
  value        Decimal
  minPurchase  Decimal?
  maxDiscount  Decimal?
  maxUses      Int?
  usedCount    Int      @default(0)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CmsPage {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         Json?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("cms_pages")
}

model Media {
  id          String   @id @default(cuid())
  fileName    String
  originalName String
  mimeType    String
  size        Int
  url         String
  width       Int?
  height      Int?
  alt         String?
  folder      String?  // "products" | "banners" | "pages" | "general"
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
  @@map("media")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique  // "order_confirmation", "password_reset", "shipping_update"
  subject   String
  htmlBody  String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // "product.created", "order.updated", "user.banned"
  entity    String?  // "product", "order", "user"
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ShippingConfig {
  id                String  @id @default("default")
  freeThreshold     Decimal @default(5000)
  valleyCost        Decimal @default(200)
  outsideValleyCost Decimal @default(500)
  provinceCosts     Json?
  updatedAt         DateTime @updatedAt

  @@map("shipping_config")
}

model TaxConfig {
  id       String  @id @default("default")
  name     String  @default("VAT")
  rate     Decimal @default(0.13)
  isActive Boolean @default(true)

  @@map("tax_config")
}

model BackInStockRequest {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  isNotified Boolean @default(false)
  createdAt DateTime @default(now())
  notifiedAt DateTime?

  @@unique([email, productId, variantId])
  @@index([productId, isNotified])
  @@index([email])
  @@map("back_in_stock_requests")
}

model GiftCard {
  id        String   @id @default(cuid())
  code      String   @unique
  balance   Decimal  @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String?
  expiresAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([userId])
  @@map("gift_cards")
}
